# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/whatsapp_orders
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/whatsapp_orders

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# AI Services
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_API_URL=https://api.sarvam.ai/v1
OPENAI_API_KEY=your_openai_api_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=whatsapp-orders-bucket
S3_REGION=ap-south-1

# Application
APP_NAME=WhatsApp Order Automation
DEBUG=false
SECRET_KEY=your_super_secret_key_here
API_V1_PREFIX=/api/v1

# GST Configuration
DEFAULT_GST_RATE=18.0
BUSINESS_GSTIN=your_gstin_number
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address

# Payment Reminders
PAYMENT_REMINDER_DAYS=7,14,30
CREDIT_LIMIT_DEFAULT=50000.00
