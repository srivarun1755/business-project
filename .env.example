# Application
APP_NAME=WhatsApp Order Automation Platform
DEBUG=false
SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://orders:orders@localhost:5432/orders_db
DATABASE_URL_SYNC=postgresql://orders:orders@localhost:5432/orders_db

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_URL=https://graph.facebook.com/v20.0

# Sarvam AI (Speech-to-Text)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# LLM (Order Parsing) — OpenAI-compatible endpoint
LLM_API_KEY=your_openai_api_key
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512

# S3-compatible Object Storage (for invoice PDFs)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_INVOICES=invoices

# Business Defaults
DEFAULT_CREDIT_LIMIT=50000
